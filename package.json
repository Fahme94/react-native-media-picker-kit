{
  "name": "react-native-media-picker",
  "version": "0.1.0",
  "description": "Pick or capture images (with cropping) and videos. New Architecture only.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin",
    "!**/__tests__"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "image-picker",
    "video-picker",
    "camera",
    "crop",
    "turbomodule",
    "expo"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "expo": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.6.0"
  },
  "codegenConfig": {
    "name": "RNMediaPickerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mediapicker"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
