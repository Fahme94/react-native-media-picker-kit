{
  "name": "react-native-media-picker-kit",
  "version": "0.2.2",
  "description": "Pick or capture photos and videos, with built-in cropping and compression to a target file size. No gallery permission needed. New Architecture only.",
  "homepage": "https://github.com/Fahme94/react-native-media-picker#readme",
  "bugs": {
    "url": "https://github.com/Fahme94/react-native-media-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fahme94/react-native-media-picker.git"
  },
  "author": "Ahmed Fahmy <13001300+Fahme94@users.noreply.github.com>",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin",
    "!android/build",
    "!android/src/androidTest",
    "!android/.gradle",
    "!android/.settings",
    "!android/.cxx",
    "!**/__tests__"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src plugin app.plugin.js",
    "format": "prettier --write src plugin app.plugin.js",
    "test": "jest",
    "clean": "rm -rf lib android/build android/.gradle"
  },
  "keywords": [
    "react-native",
    "expo",
    "media-picker",
    "image-picker",
    "video-picker",
    "photo-picker",
    "gallery",
    "camera",
    "image-crop-picker",
    "crop",
    "image-compression",
    "video-compression",
    "compress",
    "new-architecture",
    "turbomodule",
    "ios",
    "android",
    "typescript"
  ],
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=50.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.79.0",
    "@react-native/eslint-config": "0.79.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.6.0"
  },
  "codegenConfig": {
    "name": "RNMediaPickerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mediapicker"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ],
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            "module:@react-native/babel-preset"
          ]
        }
      ]
    }
  }
}
